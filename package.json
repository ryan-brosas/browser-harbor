{
  "name": "@ryan-brosas/browser-harbor",
  "version": "0.0.0",
  "private": true,
  "description": "Pi-native browser tools built around explicit browser ownership and the browser-harness runtime. Bootstrap only.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "browser",
    "cdp"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ryan-brosas/browser-harbor.git"
  },
  "engines": {
    "node": ">=24"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "files": [
    "src",
    "docs",
    "README.md",
    "CONTRIBUTING.md",
    "SECURITY.md"
  ],
  "scripts": {
    "check": "npm run lint && npm run typecheck && npm test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@types/node": "26.6.5",
    "typebox": "1.3.27",
    "typescript": "5.9.3"
  }
}
